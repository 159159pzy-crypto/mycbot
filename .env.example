# Copy this file to .env for local development. Every credential below is a
# non-production placeholder; replace it before exposing any service.

COMPOSE_PROJECT_NAME=mybot
MYBOT_IMAGE_TAG=dev

# Host ports are loopback-bound by compose.yaml.
API_PORT=8000
WEB_PORT=4173
POSTGRES_PORT=5432
REDIS_PORT=6379
SEARXNG_PORT=8080

# PostgreSQL container settings. Keep the password URL-safe because Compose
# also places it in MYBOT_DATABASE_URL for application containers.
POSTGRES_DB=mybot
POSTGRES_USER=mybot
POSTGRES_PASSWORD=mybot-local-change-me

# Settings used when application roles run directly on the host.
MYBOT_API_HOST=127.0.0.1
MYBOT_API_PORT=8000
MYBOT_HEALTH_PROBE_TIMEOUT_SECONDS=2
MYBOT_DATABASE_CONNECT_TIMEOUT_SECONDS=3
MYBOT_DATABASE_READ_TIMEOUT_SECONDS=3
MYBOT_DATABASE_URL=postgresql+psycopg://mybot:mybot-local-change-me@127.0.0.1:5432/mybot
MYBOT_REDIS_CONNECT_TIMEOUT_SECONDS=2
MYBOT_REDIS_READ_TIMEOUT_SECONDS=2
MYBOT_REDIS_URL=redis://127.0.0.1:6379/0
MYBOT_LOG_LEVEL=INFO
MYBOT_OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional platform credentials. Empty values disable authenticated access in
# this foundation; never commit real tokens.
MYBOT_TELEGRAM_BOT_TOKEN=
MYBOT_QQ_ACCESS_TOKEN=

# The plugin runner receives only these two placeholders. Compose defaults the
# broker URL to the API service on its isolated internal network.
MYBOT_PLUGIN_BROKER_URL=
MYBOT_PLUGIN_CONFIG=

# SearXNG's runtime overrides the placeholder in settings.yml with this
# local-only value. Use a long random value outside local development.
SEARXNG_SECRET_KEY=mybot-searxng-local-change-me

# NapCat is intentionally external to this Compose stack. A later QQ adapter
# can connect to a separately managed instance at this URL.
NAPCAT_WS_URL=
