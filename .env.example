# Copy this file to .env for local development. Every credential below is a
# non-production placeholder; replace it before exposing any service.

COMPOSE_PROJECT_NAME=mybot
MYBOT_IMAGE_TAG=dev

# Host ports are loopback-bound by compose.yaml.
API_PORT=8000
WEB_PORT=4173
POSTGRES_PORT=5432
REDIS_PORT=6379
SEARXNG_PORT=8080

# PostgreSQL container settings. Keep the password URL-safe because Compose
# also places it in MYBOT_DATABASE_URL for application containers.
POSTGRES_DB=mybot
POSTGRES_USER=mybot
POSTGRES_PASSWORD=mybot-local-change-me

# Settings used when application roles run directly on the host.
MYBOT_API_HOST=127.0.0.1
MYBOT_API_PORT=8000
MYBOT_HEALTH_PROBE_TIMEOUT_SECONDS=2
MYBOT_DATABASE_CONNECT_TIMEOUT_SECONDS=3
MYBOT_DATABASE_READ_TIMEOUT_SECONDS=3
MYBOT_DATABASE_URL=postgresql+psycopg://mybot:mybot-local-change-me@127.0.0.1:5432/mybot
MYBOT_REDIS_CONNECT_TIMEOUT_SECONDS=2
MYBOT_REDIS_READ_TIMEOUT_SECONDS=2
MYBOT_REDIS_URL=redis://127.0.0.1:6379/0
MYBOT_LOG_LEVEL=INFO
MYBOT_OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional platform credentials. An empty value disables that platform's
# adapter in the gateway; never commit real tokens.
MYBOT_TELEGRAM_BOT_TOKEN=
MYBOT_QQ_ACCESS_TOKEN=

# Messaging spine settings. Connection ids namespace conversation identities,
# so changing them later starts new conversation histories.
MYBOT_QQ_CONNECTION_ID=qq-main
MYBOT_TELEGRAM_CONNECTION_ID=telegram-main
MYBOT_SANDBOX_CONNECTION_ID=sandbox
MYBOT_TELEGRAM_API_BASE_URL=https://api.telegram.org
MYBOT_TELEGRAM_POLL_TIMEOUT_SECONDS=50

# Agent LLM access (any OpenAI-compatible endpoint: DeepSeek, Qwen, Kimi,
# OpenAI, or local vLLM/Ollama). Leave MYBOT_LLM_BASE_URL empty to run without
# an agent; answerable messages then receive an explicit fallback reply.
MYBOT_LLM_BASE_URL=
MYBOT_LLM_API_KEY=
MYBOT_LLM_MODEL=deepseek-chat

# Image understanding. "describe" asks the purpose-routed vision model for a
# bounded Chinese description before the chat turn; "direct" sends OpenAI
# image_url content parts to the chat model; "off" keeps readable references.
MYBOT_VISION_MODE=describe
MYBOT_VISION_MAX_DESCRIPTION_CHARS=2000

# Optional env-only secret map for runtime model channels. Channel JSON stored
# in system_kv contains only a reference such as PRIMARY_MODEL_KEY; the value
# lives here. Example (do not commit real values):
# MYBOT_MODEL_API_KEYS={"PRIMARY_MODEL_KEY":"replace-me"}
MYBOT_MODEL_API_KEYS=
MYBOT_MODEL_CHANNEL_COOLDOWN_SECONDS=60
MYBOT_MODEL_CHANNELS_CACHE_TTL_SECONDS=30

# Daily token ceilings guard spend; 0 disables a ceiling.
MYBOT_AGENT_DAILY_TOKEN_CEILING=200000
MYBOT_AGENT_CONVERSATION_DAILY_TOKEN_CEILING=20000

# User-visible Chinese fallback text. Keep these deterministic so operators can
# recognize which guard/dependency caused a degraded reply.
MYBOT_FALLBACK_NOT_CONFIGURED=语言模型尚未配置, 请管理员先完成模型渠道设置。
MYBOT_FALLBACK_LLM_FAILURE=语言模型暂时不可用, 请稍后再试。
MYBOT_FALLBACK_BUDGET_EXCEEDED=本会话今天的 token 预算已用完, 明天再继续聊吧。
MYBOT_FALLBACK_EMPTY_REPLY=抱歉, 这次没能组织好回复, 请稍后再试。
MYBOT_FALLBACK_MODERATION=回复触发了内容策略, 已停止发送。

# Memory. Embeddings default to the LLM endpoint above; point these elsewhere
# when your chat provider has no /embeddings API (e.g. DeepSeek). Leaving both
# endpoints empty disables memory entirely.
MYBOT_EMBEDDING_BASE_URL=
MYBOT_EMBEDDING_API_KEY=
MYBOT_EMBEDDING_MODEL=text-embedding-3-small
MYBOT_MEMORY_ENABLED=true
MYBOT_MEMORY_MIN_CONFIDENCE=0.6
MYBOT_MEMORY_MAINTENANCE_INTERVAL_SECONDS=3600

# Agent tools. Compose points MYBOT_SEARXNG_URL at the bundled SearXNG
# service; host-run workers use the loopback default. Capabilities gate which
# tools the agent may call; clear the list to disable tools entirely.
MYBOT_SEARXNG_URL=http://127.0.0.1:8080
MYBOT_AGENT_GRANTED_CAPABILITIES=web.search,web.fetch
MYBOT_TOOL_MAX_CALLS_PER_TURN=5
MYBOT_TOOL_TIMEOUT_SECONDS=15
MYBOT_TURN_DEADLINE_SECONDS=90

# The plugin runner receives only these two placeholders. Compose defaults the
# broker URL to the API service on its isolated internal network. Enable the
# in-repo example plugin with:
#   MYBOT_PLUGIN_CONFIG={"plugins": ["mybot.plugins.examples.dice:PLUGIN"]}
MYBOT_PLUGIN_BROKER_URL=
MYBOT_PLUGIN_CONFIG=

# Capability grants per plugin id (JSON). A plugin whose manifest requests
# capabilities beyond its grant is refused at registration with an audit log
# entry. The example dice plugin requests none, so {} suffices.
MYBOT_PLUGIN_CAPABILITY_GRANTS={}

# Operator console access. Every /operator API requires this bearer token;
# leaving it empty disables the operator API entirely (fail closed). Use a
# long random value and never commit the real one.
MYBOT_OPERATOR_TOKEN=

# Abuse guards. Rate limits are per minute (0 disables one); the cooldown
# spaces out agent replies inside one group chat; the loop guard ignores
# bot senders and echoed replies.
MYBOT_RATE_LIMIT_USER_PER_MINUTE=20
MYBOT_RATE_LIMIT_CHAT_PER_MINUTE=30
MYBOT_GROUP_COOLDOWN_SECONDS=3
MYBOT_INPUT_MAX_CHARS=4000

# Proactive check-ins (off by default). Conversations opt in via the
# operator API; quiet hours are UTC and may wrap midnight.
MYBOT_PROACTIVE_ENABLED=false
MYBOT_PROACTIVE_MIN_INTERVAL_HOURS=24
MYBOT_PROACTIVE_QUIET_START_HOUR=22
MYBOT_PROACTIVE_QUIET_END_HOUR=8

# Pin third-party images for production, e.g.
# SEARXNG_IMAGE_TAG=2025.7.1-abcdef@sha256:...  (docker inspect --format
# '{{index .RepoDigests 0}}' searxng/searxng:<tag> after review).
SEARXNG_IMAGE_TAG=latest

# SearXNG's runtime overrides the placeholder in settings.yml with this
# local-only value. Use a long random value outside local development.
SEARXNG_SECRET_KEY=mybot-searxng-local-change-me

# NapCat is intentionally external to this Compose stack. A later QQ adapter
# can connect to a separately managed instance at this URL.
NAPCAT_WS_URL=
